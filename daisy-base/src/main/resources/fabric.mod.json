{
  "schemaVersion": 1,
  "id": "daisy-base",
  "version": "${version}",
  "name": "Daisy Base",
  "description": "Daisy Server utilities base module",
  "authors": [
    "macuguita"
  ],
  "contact": {
    "homepage": "https://macuguita.com/",
    "sources": "https://github.com/macuguita/daisy-server-utilitites"
  },
  "license": "MIT",
  "icon": "assets/daisy-base/icon.png",
  "environment": "*",
  "mixins": [
    "daisy-base.mixins.json"
  ],
  "accessWidener": "daisy-base.accesswidener",
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": "1.21.1",
    "fabric-api": "*",
    "fabric-language-kotlin": "*"
  },
  "custom": {
    "modmenu": {
      "parent": {
        "id": "daisy-server-utilities"
      }
    },
    "loom:injected_interfaces": {
      "net/minecraft/world/level/storage/PlayerDataStorage": [
        "com/macuguita/daisy/daisy_base/duck/CustomPlayerDataStorage"
      ]
    }
  }
}
